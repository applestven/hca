{
  "name": "Sub获客",
  "key": "sub_guest",
  "entry": "main.py",
  "version": "0.1.0",
  "description": "按话术状态机自动回复 Sub 会话；进度存 SQLite，支持等待回复、失败重试、多设备锁。",
  "author": "hca",
  "category": "Sub",
  "params": [
    {
      "key": "limit",
      "label": "对话次数",
      "type": "number",
      "required": true,
      "default": 10
    },
    {
      "key": "delay_min",
      "label": "消息间隔min(秒)",
      "type": "number",
      "required": false,
      "default": 0.8,
      "placeholder": "0.1–10，句本内多条消息间隔"
    },
    {
      "key": "delay_max",
      "label": "消息间隔max(秒)",
      "type": "number",
      "required": false,
      "default": 1.5,
      "placeholder": "0.1–10，需 ≥ min"
    },
    {
      "key": "back_delay_min",
      "label": "发送后返回min(秒)",
      "type": "number",
      "required": false,
      "default": 0.3,
      "placeholder": "发完后等待再返回列表"
    },
    {
      "key": "back_delay_max",
      "label": "发送后返回max(秒)",
      "type": "number",
      "required": false,
      "default": 0.8,
      "placeholder": "需 ≥ min"
    },
    {
      "key": "wait_reply",
      "label": "需对方回复再推进(1/0)",
      "type": "number",
      "required": false,
      "default": 1
    },
    {
      "key": "max_retry",
      "label": "最大重试次数",
      "type": "number",
      "required": false,
      "default": 3
    },
    {
      "key": "package",
      "label": "App包名",
      "type": "text",
      "required": false,
      "default": "com.MinorityCulture.MinorityCulture",
      "placeholder": "默认 com.MinorityCulture.MinorityCulture"
    },
    {
      "key": "dry_run",
      "label": "仅跑状态机不点UI(1/0)",
      "type": "number",
      "required": false,
      "default": 0
    }
  ]
}
